# Copiar a .env y completar. .env nunca se commitea.

NODE_ENV=development
# Local usa 4000 para no chocar con el `next dev` del frontend (3000). Railway inyecta su propio PORT.
PORT=4000

# --- Base de datos (Postgres del proyecto de Supabase) ---
# Supabase → botón "Connect" → Type: URI → Method: "Session pooler" → copiar la URI.
# Usar el Session pooler (IPv4, puerto 5432), NO el Transaction pooler (6543).
# La conexión directa (db.<ref>.supabase.co) es solo IPv6: falla con ENOTFOUND/ENETUNREACH
# en redes sin IPv6, que son la mayoría de las conexiones hogareñas.
# Si la contraseña tiene @ # / % : etc., va codificada (ej. @ → %40).
DATABASE_URL=postgresql://postgres.etwiwzuwwnzijdxjbfqx:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
# Opcional: certificado CA de Supabase (Database → SSL Configuration → Download certificate), en PEM.
# Si está vacío se usa SSL sin verificar el certificado (cifrado igual, pero sin validar el servidor).
DATABASE_SSL_CA=

# --- Supabase Auth ---
# Los JWT se verifican contra el JWKS público: <SUPABASE_URL>/auth/v1/.well-known/jwks.json (ES256).
SUPABASE_URL=https://etwiwzuwwnzijdxjbfqx.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...), o la legacy "service_role".
# Permite invitar, banear y borrar usuarios y saltea RLS: SOLO en el backend, nunca en el front.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Frontend ---
# Los links de invitación vuelven a <FRONTEND_URL>/reset-password (tiene que estar en
# Supabase → Authentication → URL Configuration → Redirect URLs).
# Probando con el front en local: http://localhost:3000. Con el de producción: la URL de Vercel.
FRONTEND_URL=http://localhost:3000

# --- Google OAuth (conexión de casillas) ---
# Google Cloud Console → Google Auth Platform → Clients → (Web application).
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Tiene que estar en "Authorized redirect URIs" del client, idéntica (sin barra final).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/mailboxes/oauth/callback
# Generar cada una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GOOGLE_TOKEN_ENCRYPTION_KEY encripta los refresh_token: si cambia, hay que reconectar las casillas.
GOOGLE_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# --- CORS: orígenes permitidos, separados por coma ---
CORS_ORIGINS=http://localhost:3000,https://corebio-email-collection.vercel.app
