# Copiar a .env y completar. .env nunca se commitea.

NODE_ENV=development
# Local usa 4000 para no chocar con el `next dev` del frontend (3000). Railway inyecta su propio PORT.
PORT=4000

# --- Base de datos (Postgres del proyecto de Supabase) ---
# Supabase → Project Settings → Database → Connection string → URI.
# Conexión directa (IPv6): db.<ref>.supabase.co:5432
# Si Railway no llega por IPv6, usar el "Session pooler" (puerto 5432, NO el transaction pooler 6543).
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.etwiwzuwwnzijdxjbfqx.supabase.co:5432/postgres
DATABASE_SSL=true
# Opcional: certificado CA de Supabase (Database → SSL Configuration → Download certificate), en PEM.
# Si está vacío se usa SSL sin verificar el certificado (cifrado igual, pero sin validar el servidor).
DATABASE_SSL_CA=

# --- Supabase Auth ---
# Los JWT se verifican contra el JWKS público: <SUPABASE_URL>/auth/v1/.well-known/jwks.json (ES256).
SUPABASE_URL=https://etwiwzuwwnzijdxjbfqx.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# --- CORS: orígenes permitidos, separados por coma ---
CORS_ORIGINS=http://localhost:3000,https://corebio-email-collection.vercel.app
