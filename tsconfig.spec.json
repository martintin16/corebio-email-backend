{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Solo para Jest: ts-jest transpila cada archivo sin chequear tipos (mucho más
    // liviano). Los tipos los chequean `npm run build` y `npm run typecheck`, que usan
    // tsconfig.json y no se ven afectados.
    "isolatedModules": true,
    // Para poder transformar a CommonJS las dependencias solo-ESM de sanitize-html
    // (ver transformIgnorePatterns en la config de Jest).
    "allowJs": true
  }
}
